{
  "name": "FlightScanner",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["openai.chatgpt", "ms-python.python", "ms-python.vscode-pylance", "github.vscode-pull-request-github", "github.github-vscode-theme", "george-alisson.html-preview-vscode"]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "FlightScanner preview", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash scripts/setup-workspace.sh"
}
