{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightscanner-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "routes": [
    {
      "pattern": "btsflightscaner.rodulab.com/api/contact*",
      "zone_name": "rodulab.com"
    },
    {
      "pattern": "btsflightscaner.rodulab.com/api/statistics*",
      "zone_name": "rodulab.com"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ENGAGEMENT",
      "dataset": "flightscanner_engagement"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://btsflightscaner.rodulab.com",
    "EXPECTED_HOSTNAME": "btsflightscaner.rodulab.com",
    "CLOUDFLARE_ACCOUNT_ID": "033ec39e1948bd5785d92d1993a8036f",
    "CONTACT_FROM_EMAIL": "contact@notify.rodulab.com"
  },
  "secrets": {
    "required": [
      "CONTACT_EMAIL",
      "TURNSTILE_SECRET",
      "TURNSTILE_SITE_KEY",
      "CLOUDFLARE_ANALYTICS_TOKEN"
    ]
  },
  "observability": {
    "enabled": true
  }
}
